{
  "name": "Debian Development Container",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Features to add to the dev container
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true,
      "username": "vscode",
      "uid": "1000",
      "gid": "1000"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally
  "forwardPorts": [],

  // Configure tool-specific properties
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },

  // Automatically install dotfiles after container creation
  // Uses DOTFILES_REPO env var if set, otherwise defaults to jancel/dotfiles
  // Note: VS Code has built-in dotfiles support via user settings (dotfiles.repository)
  // This postCreateCommand ensures dotfiles are installed even if that's not configured
  "postCreateCommand": "bash -c 'REPO=${localEnv:DOTFILES_REPO:https://github.com/jancel/dotfiles.git}; if [ ! -d ~/.dotfiles ]; then git clone $REPO ~/.dotfiles && cd ~/.dotfiles && chmod +x install.sh && ./install.sh; else cd ~/.dotfiles && git pull && make fast-update; fi'",

  // Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root
  "remoteUser": "vscode"
}
