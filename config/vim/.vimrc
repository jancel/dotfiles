" Basic settings
syntax enable
set number
set relativenumber
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4
set autoindent
set smartindent

" Search
set incsearch
set hlsearch
set ignorecase
set smartcase

" UI
set cursorline
set showmatch
set wildmenu

" Performance
set lazyredraw

" No swap files
set nobackup
set nowritebackup
set noswapfile
