[user]
	name = Your Name
	email = your.email@example.com

[core]
	excludesfile = ~/.gitignore_global
	editor = vim

[color]
	ui = auto

[push]
	default = current

[pull]
	rebase = true

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	lg = log --graph --oneline --decorate

# Include local-only git configuration (private, never committed)
[include]
	path = ~/.dotfiles/local/local.gitconfig
